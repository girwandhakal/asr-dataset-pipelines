# Data: keep the folder structure, never the data itself.
# The first rule ignores everything under data/, the second lets git descend
# into subdirectories, and the third keeps the .gitkeep placeholders that make
# the empty folders exist in the repository.
data/**
!data/**/
!data/**/.gitkeep

# Local inputs and figures that are not part of the code.
dataset-filters.png

# Secrets and local environment settings.
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Tooling and OS noise
.vscode/
.idea/
.pytest_cache/
.mypy_cache/
.ruff_cache/
Thumbs.db
desktop.ini
*~

# Local audio archive
asr-media.zip
